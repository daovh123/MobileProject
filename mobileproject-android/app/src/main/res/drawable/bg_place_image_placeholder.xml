<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FFD8ADC6"
                android:endColor="#FF8F6B8A" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00000000"
                android:centerColor="#12000000"
                android:endColor="#55000000" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_restaurant_24"
        android:gravity="center" />
</layer-list>
