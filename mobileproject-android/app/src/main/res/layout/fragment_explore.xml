<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            app:layout_scrollFlags="scroll|enterAlways">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilExploreQuery"
                style="@style/Widget.MobileProject.Explore.DockedSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:endIconDrawable="@drawable/ic_tune_24"
                app:endIconMode="custom"
                app:endIconTint="?attr/colorPrimary"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="?attr/colorPrimary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExploreQuery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/explore_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:textAppearance="@style/TextAppearance.MobileProject.GoogleSans.Body" />
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="2dp"
                    android:paddingBottom="4dp">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/cgExploreType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="8dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTypeAll"
                            style="@style/Widget.MobileProject.Explore.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/explore_type_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTypeFood"
                            style="@style/Widget.MobileProject.Explore.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/explore_type_food" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTypeDrink"
                            style="@style/Widget.MobileProject.Explore.FilterChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/explore_type_drink" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNearMe"
                        style="@style/Widget.MobileProject.Explore.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:checkable="true"
                        android:text="@string/explore_filter_near_me" />
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/llExploreAdvancedFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MobileProject.Explore.FilterInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actExploreArea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:dropDownHorizontalOffset="0dp"
                            android:dropDownVerticalOffset="2dp"
                            android:dropDownWidth="match_parent"
                            android:gravity="start|center_vertical"
                            android:hint="@string/explore_area_hint"
                            android:includeFontPadding="false"
                            android:inputType="none"
                            android:maxLines="1"
                            android:minHeight="46dp"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp"
                            android:textAppearance="@style/TextAppearance.MobileProject.GoogleSans.Body" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MobileProject.Explore.FilterInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                android:id="@+id/actExploreMinRating"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:dropDownHorizontalOffset="0dp"
                                android:dropDownVerticalOffset="2dp"
                                android:dropDownWidth="match_parent"
                                android:ellipsize="end"
                                android:gravity="start|center_vertical"
                                android:hint="@string/explore_min_rating_hint"
                                android:includeFontPadding="false"
                                android:inputType="none"
                                android:maxLines="1"
                                android:minHeight="46dp"
                                android:paddingStart="14dp"
                                android:paddingTop="12dp"
                                android:paddingEnd="40dp"
                                android:paddingBottom="12dp"
                                android:textAppearance="@style/TextAppearance.MobileProject.GoogleSans.Body" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MobileProject.Explore.FilterInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etExploreRadius"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/explore_radius_hint"
                                android:inputType="numberDecimal"
                                android:maxLines="1"
                                android:minHeight="46dp"
                                android:textAppearance="@style/TextAppearance.MobileProject.GoogleSans.Body" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExploreRandom"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minHeight="44dp"
                        android:text="@string/explore_random_action"
                        app:backgroundTint="?attr/colorPrimaryContainer"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_restaurant_24"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvExploreRandomResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_explore_random_result"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textAppearance="@style/TextAppearance.MobileProject.GoogleSans.Body"
                android:textColor="?attr/colorOnTertiaryContainer"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llExploreTrendingSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/explore_trending_title"
                        android:textAppearance="@style/TextAppearance.MobileProject.GoogleSans.Title"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnTrendingCollapse"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/explore_trending_collapse"
                        android:padding="4dp"
                        android:src="@drawable/ic_expand_less_24"
                        android:tint="?attr/colorOnSurface" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvExploreTrending"
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingStart="2dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressExplore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvExploreMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/md3_on_surface_variant"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExploreRetry"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="@string/explore_retry"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvExploreFeedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/explore_feed_title"
                android:textAppearance="@style/TextAppearance.MobileProject.GoogleSans.Title"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvExploreResultCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.MobileProject.GoogleSans.Label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvExplorePlaces"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="26dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressExplorePaging"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
