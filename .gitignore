# Cấu trúc file .gitignore chuẩn cho Android/Kotlin (Clean Architecture)

# 1. Các file tạm của hệ thống và IDE
*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/captures
.externalNativeBuild
.cxx
local.properties

# 2. Thư mục Build (Quan trọng nhất - không bao giờ push thư mục này)
**/build/
/build

# 3. Kotlin & Java
*.class
*.kt.tooling.log

# 4. Android Studio & IntelliJ
*.iws
*.out
.idea/

# 5. Keystore & Secrets (Bảo mật: Không bao giờ push file ký app lên Git công khai)
*.jks
*.keystore
google-services.json

# 6. Log files
*.log

# 7. Local configuration (Dành cho việc cấu hình môi trường riêng)
.idea/deploymentTargetSelector.xml

# 8. VS Code & Visual Studio
.vscode/
.vs/
*.visual

# 9. Backend (Maven/Spring Boot)
**/target/
*.war
*.ear

# 10. Môi trường & Biến bí mật (Bảo mật tuyệt đối)
.env
.env.*
*.local
apikey.properties
config.properties
*.pem
*.key
*.cert
*.cer
credentials.json
client_secret.json

# 11. File tạm do Hệ điều hành tự sinh ra
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 12. Local planning notes
plan.md
